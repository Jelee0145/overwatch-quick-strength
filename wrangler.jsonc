{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quick-strength-friends",
  "main": "backend/src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/tools/*", "/api/*", "/login", "/admin", "/reset"], "html_handling": "none"},
  "durable_objects": {"bindings": [{"name": "AUTH", "class_name": "AuthDirectory"}, {"name": "TASKS", "class_name": "UserTasks"}, {"name": "EVENTS", "class_name": "EventCenter"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AuthDirectory", "UserTasks"]}, {"tag": "v2", "new_sqlite_classes": ["EventCenter"]}],
  "vars": {"DASHEN_DTS": "2026", "DASHEN_SERVER": "1", "EVENTS_CONTACT": "https://106.55.47.68:8443"},
  "triggers": {"crons": ["0 * * * *"]},
  "observability": {"enabled": false},
  "rules": [{"type": "Text", "globs": ["**/*.md"], "fallthrough": true}]
}
