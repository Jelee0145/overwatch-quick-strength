{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quick-strength-friends",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/api/*", "/login", "/admin", "/reset"], "html_handling": "none"},
  "durable_objects": {"bindings": [{"name": "AUTH", "class_name": "AuthDirectory"}, {"name": "TASKS", "class_name": "UserTasks"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AuthDirectory", "UserTasks"]}],
  "vars": {"DASHEN_DTS": "2026", "DASHEN_SERVER": "1"},
  "observability": {"enabled": false},
  "rules": [{"type": "Text", "globs": ["**/*.md"], "fallthrough": true}]
}
